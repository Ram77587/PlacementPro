# PlacementPro Environment Variables Example

# Application Settings
APP_NAME="PlacementPro API"
APP_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL / Supabase)
#
# Option A - Supabase Session Pooler (Recommended for FastAPI/SQLAlchemy):
# DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
#
# Option B - Supabase Direct Connection (IPv6 enabled):
# DATABASE_URL=postgresql+psycopg2://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
#
# Option C - Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/placementpro
#
# Option D - Zero-dependency Local SQLite fallback:
# DATABASE_URL=sqlite:///./placementpro.db
#
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/placementpro

# JWT Authentication
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API Configuration for AI ATS Compatibility Scoring
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
